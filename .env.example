# ─── Required ───────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ─── Access Control ─────────────────────────────────────────
# Comma-separated Telegram user IDs that can use the bot.
# Leave empty to allow ALL users (not recommended for public bots).
ALLOWED_USER_IDS=123456789,987654321

# ─── Extension Registry ─────────────────────────────────────
# Community extension repository for SpotiFLAC providers
SPOTIFLAC_REGISTRIES=https://raw.githubusercontent.com/zarzet/SpotiFLAC-Extension/main/registry.json

# ─── Providers ──────────────────────────────────────────────
# Priority-ordered list of lossless providers (installed via registry).
SERVICES=tidal-web,qobuz-web,deezer,amazon,ytmusic-spotiflac

# ─── Storage ────────────────────────────────────────────────
# Temporary directory for downloads (auto-cleaned after upload).
DOWNLOAD_DIR=/tmp/spotiflac

# Max file size in MB before rejecting the upload (Telegram limit = 50 MB).
MAX_FILE_MB=49
