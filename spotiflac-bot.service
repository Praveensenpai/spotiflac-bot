[Unit]
Description=SpotiFLAC Telegram Lossless Music Downloader Bot
After=network.target

[Service]
Type=simple
# Replace %USER% and paths with your server user and installation directory (e.g., /opt/spotiflac-bot)
User=%USER%
WorkingDirectory=/home/paisen/Projects/spotiflac-bot
EnvironmentFile=/home/paisen/Projects/spotiflac-bot/.env
Environment=DISPLAY=:99
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/env uv run python -m spotiflac_bot
Restart=always
RestartSec=5

# Hardening / Isolation
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
